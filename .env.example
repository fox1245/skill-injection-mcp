# Skill Injection MCP - copy to .env and fill in values.
# Loaded automatically from the process working directory (see config.py).

# Required for real OpenRouter embeddings + multi-query expansion
# (omit or leave empty to use FakeEmbedder / skip multi-query).
OPENROUTER_API_KEY=

# Skill scan root (folders containing SKILL.md). Default: fixtures/skills
SKILL_INJECT_SKILLS_DIR=fixtures/skills

# SQLite / index storage directory. Default: .skill_inject_index
SKILL_INJECT_INDEX_DIR=.skill_inject_index

# Embedding (defaults match the locked design)
SKILL_INJECT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
SKILL_INJECT_EMBEDDING_DIM=1024
# Maximum documents per embedding request
SKILL_INJECT_EMBEDDING_BATCH_SIZE=32
# HTTP read timeout in seconds; connection timeout remains 10 seconds
SKILL_INJECT_EMBEDDING_TIMEOUT_S=180
SKILL_INJECT_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# Force FakeEmbedder even if OPENROUTER_API_KEY is set (true/false)
SKILL_INJECT_USE_FAKE_EMBEDDER=false

# Retrieval
SKILL_INJECT_RRF_K=60
# Internal sparse/dense channel size before RRF (per query)
SKILL_INJECT_RETRIEVE_TOP_K=20
# Default returned evidence width when constraints.top_k omitted
SKILL_INJECT_RESOLVE_TOP_K=5

# Multi-query expansion (OpenRouter chat). Default true; effective only with API key.
# Prefers fast providers Cerebras then Groq with allow_fallbacks=true.
SKILL_INJECT_MULTI_QUERY=true
SKILL_INJECT_MULTI_QUERY_MODEL=openai/gpt-oss-120b
SKILL_INJECT_MULTI_QUERY_TIMEOUT_S=30

# Rerank stub: off | qwen3-0.6b (non-off skips and sets retriever_degraded)
SKILL_INJECT_RERANK=off

# Verification: lexical (offline default) | semantic (explicit opt-in).
# Semantic sends the ORIGINAL requirement and top candidate descriptions/bodies
# to the chat endpoint above. API errors remain unknown; no lexical fallthrough.
SKILL_INJECT_VERIFICATION_MODE=lexical
SKILL_INJECT_VERIFICATION_MODEL=openai/gpt-oss-120b
# Independent of returned evidence width (RESOLVE_TOP_K)
SKILL_INJECT_VERIFICATION_TOP_K=5
SKILL_INJECT_VERIFICATION_TIMEOUT_S=120
# Full sources larger than this abstain; never truncate away non-goals
SKILL_INJECT_VERIFICATION_MAX_SOURCE_CHARS=16000
SKILL_INJECT_VERIFICATION_CACHE_SIZE=256

# Optional manifest exported from Codex skills/list, including enabled plugin skills.
# Overrides SKILLS_DIR unless the tool request explicitly provides skills_dir.
# SKILL_INJECT_SKILL_MANIFEST=C:/path/to/catalog.json

# Reuse document vectors across server restarts; keyed by model and document hash.
SKILL_INJECT_PERSISTENT_EMBEDDING_CACHE=false
