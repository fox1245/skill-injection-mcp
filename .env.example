# Skill Injection MCP - copy to .env and fill in values.
# Loaded automatically from the process working directory (see config.py).

# Required for real OpenRouter embeddings + multi-query expansion
# (omit or leave empty to use FakeEmbedder / skip multi-query).
OPENROUTER_API_KEY=

# Skill scan root (folders containing SKILL.md). Default: fixtures/skills
SKILL_INJECT_SKILLS_DIR=fixtures/skills

# SQLite / index storage directory. Default: .skill_inject_index
SKILL_INJECT_INDEX_DIR=.skill_inject_index

# Embedding (defaults match the locked design)
SKILL_INJECT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
SKILL_INJECT_EMBEDDING_DIM=1024
SKILL_INJECT_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# Force FakeEmbedder even if OPENROUTER_API_KEY is set (true/false)
SKILL_INJECT_USE_FAKE_EMBEDDER=false

# Retrieval
SKILL_INJECT_RRF_K=60
# Internal sparse/dense channel size before RRF (per query)
SKILL_INJECT_RETRIEVE_TOP_K=20
# Default agent-facing candidate/evidence width when constraints.top_k omitted
SKILL_INJECT_RESOLVE_TOP_K=5

# Multi-query expansion (OpenRouter chat). Default true; effective only with API key.
# Prefers fast providers Cerebras then Groq with allow_fallbacks=true.
SKILL_INJECT_MULTI_QUERY=true
SKILL_INJECT_MULTI_QUERY_MODEL=openai/gpt-oss-120b
SKILL_INJECT_MULTI_QUERY_TIMEOUT_S=12

# Rerank stub: off | qwen3-0.6b (non-off skips and sets retriever_degraded)
SKILL_INJECT_RERANK=off
